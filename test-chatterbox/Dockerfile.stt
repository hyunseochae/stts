# 베이스 이미지: RTX 5090 (Blackwell) 지원을 위해 CUDA 12.8 런타임 사용
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

# 시스템 의존성 설치
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# uv 설치
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 작업 디렉토리 설정
WORKDIR /app

# uv 환경 변수 설정
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# 가상환경 생성 및 의존성 설치
# faster-whisper, fastapi, uvicorn, python-multipart
RUN uv venv /app/.venv && \
    uv pip install faster-whisper==1.0.3 fastapi uvicorn python-multipart

# 소스 코드 복사
COPY api_stt.py .

# 포트 노출
EXPOSE 8000

# 실행 명령어
ENTRYPOINT ["uvicorn", "api_stt:app", "--host", "0.0.0.0", "--port", "8000"]
